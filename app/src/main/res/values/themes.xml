<resources>
    <style name="Theme.RoohuX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/midnight</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.RoohuX.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/midnight</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/midnight</item>
        <item name="postSplashScreenTheme">@style/Theme.RoohuX</item>
    </style>
</resources>
